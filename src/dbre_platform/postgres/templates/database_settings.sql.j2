-- These are per-database GUC overrides (ALTER DATABASE ... SET), which take
-- effect for new sessions without a server restart. Settings that require a
-- server restart (shared_preload_libraries, max_connections) are NOT here --
-- see standards.build_cluster_parameters(), which produces the
-- docker-compose `command` flags / RDS DB Parameter Group values instead.

ALTER DATABASE "{{ db_name }}" SET statement_timeout = '{{ spec.statement_timeout_ms }}ms';
ALTER DATABASE "{{ db_name }}" SET idle_in_transaction_session_timeout = '{{ spec.idle_in_transaction_timeout_ms }}ms';
ALTER DATABASE "{{ db_name }}" SET timezone = 'UTC';
ALTER DATABASE "{{ db_name }}" SET log_min_duration_statement = '{{ log_min_duration_statement_ms }}ms';

