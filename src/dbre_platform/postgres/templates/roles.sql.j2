-- Generated by dbre_platform.postgres.rbac.render_roles_sql
-- Request: {{ request.metadata.name }} ({{ request.metadata.environment }})
--
-- Standard DBRE role model: six privilege archetypes (NOLOGIN "group" roles
-- that hold GRANTs) plus one LOGIN role per archetype, scoped to this
-- application, that is granted membership in the matching group role.
-- Nothing ever connects directly as db_owner/db_app/etc. -- those exist
-- only to hold privileges, which is what makes future privilege changes a
-- single GRANT/REVOKE on the group role instead of N changes across every
-- application's login role. See docs/rbac-model.md.
--
-- Passwords are injected as psql variables (:'xxx_password') set via \set
-- immediately before this script runs (see PsqlExecutor.run_script) -- they
-- are never written into this template or into any file on disk.

-- ---------------------------------------------------------------------
-- 1. Group (privilege) roles -- created once per cluster, shared by every
--    application database. NOLOGIN: nothing ever authenticates as these.
-- ---------------------------------------------------------------------
{% for group_role in group_roles %}
DO $$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '{{ group_role }}') THEN
        CREATE ROLE {{ group_role }} NOLOGIN;
    END IF;
END
$$;
{% endfor %}

GRANT pg_monitor TO db_monitor;

-- ---------------------------------------------------------------------
-- 2. Per-application LOGIN roles, one per archetype, granted membership in
--    the matching group role. CONNECTION LIMIT is set per role, not just
--    per database, so one noisy role can't starve the others.
--
--    Passwords reach this block via session-level custom GUCs
--    (`SET dbre.xxx_password = :'xxx_password'`) rather than being written
--    directly inside the DO $$ ... $$ body: psql's `:'var'` substitution
--    does NOT reach inside dollar-quoted strings (by design, so it can't
--    mangle embedded code), so a literal `:'var'` inside a DO block is
--    sent to the server as-is and fails. Setting a GUC first -- which
--    happens as a top-level statement, where substitution does apply --
--    and reading it back with current_setting() inside the DO block is the
--    standard psql idiom for this.
-- ---------------------------------------------------------------------
SET dbre.owner_password = :'owner_password';
SET dbre.app_password = :'app_password';
SET dbre.ro_password = :'ro_password';
SET dbre.rw_password = :'rw_password';
SET dbre.migration_password = :'migration_password';
SET dbre.monitor_password = :'monitor_password';

DO $$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '{{ app_name }}_owner') THEN
        EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L CONNECTION LIMIT %s',
            '{{ app_name }}_owner', current_setting('dbre.owner_password'), {{ login_connection_limit }});
    END IF;
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '{{ app_name }}_app') THEN
        EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L CONNECTION LIMIT %s',
            '{{ app_name }}_app', current_setting('dbre.app_password'), {{ login_connection_limit }});
    END IF;
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '{{ app_name }}_ro') THEN
        EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L CONNECTION LIMIT %s',
            '{{ app_name }}_ro', current_setting('dbre.ro_password'), {{ login_connection_limit }});
    END IF;
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '{{ app_name }}_rw') THEN
        EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L CONNECTION LIMIT %s',
            '{{ app_name }}_rw', current_setting('dbre.rw_password'), {{ login_connection_limit }});
    END IF;
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '{{ app_name }}_migration') THEN
        EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L CONNECTION LIMIT %s',
            '{{ app_name }}_migration', current_setting('dbre.migration_password'), {{ migration_connection_limit }});
    END IF;
    IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '{{ app_name }}_monitor') THEN
        EXECUTE format('CREATE ROLE %I LOGIN PASSWORD %L CONNECTION LIMIT %s',
            '{{ app_name }}_monitor', current_setting('dbre.monitor_password'), {{ login_connection_limit }});
    END IF;
END
$$;

GRANT db_owner     TO {{ app_name }}_owner;
GRANT db_app       TO {{ app_name }}_app;
GRANT db_ro        TO {{ app_name }}_ro;
GRANT db_rw        TO {{ app_name }}_rw;
GRANT db_migration TO {{ app_name }}_migration;
GRANT db_monitor   TO {{ app_name }}_monitor;

-- ---------------------------------------------------------------------
-- 3. Least-privilege grants on this application's database and schema,
--    held by the group roles (never granted directly to a login role).
-- ---------------------------------------------------------------------
GRANT CONNECT ON DATABASE "{{ db_name }}" TO db_owner, db_app, db_rw, db_ro, db_migration, db_monitor;
GRANT USAGE ON SCHEMA public TO db_owner, db_app, db_rw, db_ro, db_migration;
GRANT CREATE ON SCHEMA public TO db_owner, db_migration;

-- Privileges on tables/sequences that already exist at bootstrap time.
GRANT SELECT ON ALL TABLES IN SCHEMA public TO db_ro;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO db_app, db_rw;
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO db_owner, db_migration;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO db_app, db_rw, db_migration;
GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO db_owner, db_migration;

-- Default privileges so tables/sequences created *after* bootstrap (by
-- db_owner or db_migration, e.g. via a migration tool) automatically carry
-- the same least-privilege grants, with no manual follow-up step.
ALTER DEFAULT PRIVILEGES FOR ROLE db_owner IN SCHEMA public
    GRANT SELECT ON TABLES TO db_ro;
ALTER DEFAULT PRIVILEGES FOR ROLE db_owner IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO db_app, db_rw;
ALTER DEFAULT PRIVILEGES FOR ROLE db_owner IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO db_app, db_rw;
ALTER DEFAULT PRIVILEGES FOR ROLE db_migration IN SCHEMA public
    GRANT SELECT ON TABLES TO db_ro;
ALTER DEFAULT PRIVILEGES FOR ROLE db_migration IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO db_app, db_rw;
