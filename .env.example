# Copy to .env and fill in real values, or export these directly in your
# shell. Never commit a real .env file -- it's excluded in .gitignore.
#
# These are the ONLY supported way to hand database credentials to the
# platform: dbre_platform.postgres.executor.ConnectionParams.from_env()
# reads them and refuses to run if any required one is missing. No
# command accepts a password as a CLI argument (it would leak into shell
# history and `ps` output).

# --- Connection to the PostgreSQL server the CLI operates against -----------
# For local Docker mode this is the docker-compose service on localhost;
# for K3s mode, point this at a `kubectl port-forward` to the CNPG
# <name>-rw Service (127.0.0.1 + whatever local port you forward);
# for AWS mode, point this at the RDS endpoint (see terraform output) or,
# more commonly, at a bastion/tunnel in front of it.
DBRE_PG_HOST=localhost
DBRE_PG_PORT=5432
DBRE_PG_USER=postgres
DBRE_PG_PASSWORD=change-me
DBRE_PG_SSLMODE=prefer

# --- K3s mode (spec.platform: k3s) -----------------------------------------
# kubectl resolves the cluster the standard way; the platform never reads
# kubeconfig directly. On a K3s server this is usually:
#   KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# DBRE_K8S_NAMESPACE is informational here -- the target namespace comes
# from spec.namespace in the request file (default: dbre).
# KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# DBRE_K8S_NAMESPACE=dbre

# --- Local Docker Compose superuser password --------------------------------
# Required by docker-compose.yml's POSTGRES_PASSWORD (it deliberately has
# no default -- see the ${POSTGRES_PASSWORD:?...} guard). The platform
# also auto-generates and caches a superuser password for its own use in
# .dbre/local-superuser.env if you don't set this; only set it yourself
# if you need a known value (e.g. to `psql` in manually for debugging).
POSTGRES_PASSWORD=change-me

# --- AWS mode (optional) -----------------------------------------------------
# Not read directly by this platform -- the AWS SDK (boto3) and Terraform
# both resolve credentials the standard way (AWS_PROFILE, or
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, or an instance/role profile).
# Listed here only as a reminder of what AWS mode additionally needs.
# AWS_PROFILE=your-profile
# AWS_REGION=us-east-1

# ==============================================================================
# Change Risk Engine (change_risk_engine) -- a separate product domain, see
# docs/decisions/0008-change-risk-engine-domain-separation.md. Three distinct
# env-var namespaces below for three distinct databases; never point two of
# them at the same server.
# ==============================================================================

# --- CRE_DB_*: the database a submitted change is being ANALYZED against ----
# Read-only metadata collection only (change_risk_engine.connectors.postgres) --
# never executes anything from a submitted migration. Not required in --demo
# mode (`cre analyze migration.sql --demo`, `cre demo`), which uses the ACME
# Financial fixtures instead.
# CRE_DB_HOST=localhost
# CRE_DB_PORT=5432
# CRE_DB_USER=readonly_user
# CRE_DB_PASSWORD=change-me
# CRE_DB_NAME=postgres
# CRE_DB_SSLMODE=prefer

# --- CRE_STORE_PG_*: the Change Risk Engine's OWN metadata store ------------
# Only needed if you swap the default FileAssessmentStore for
# change_risk_engine.persistence.postgres_store.PostgresAssessmentStore (see
# docker-compose.yml's `cre_store` service, profile "cre").
# CRE_STORE_PG_HOST=localhost
# CRE_STORE_PG_PORT=5433
# CRE_STORE_PG_USER=postgres
# CRE_STORE_PG_PASSWORD=change-me
# CRE_STORE_PG_DBNAME=change_risk_engine
# CRE_STORE_PG_SSLMODE=prefer

# --- Change Risk Engine API authentication -----------------------------------
# Unset (the default): every API request authenticates as an anonymous admin
# -- explicit local-dev/demo behavior (change_risk_engine.auth.NoAuthProvider),
# not a silent gap. Set this to require a Bearer token for every request.
# CRE_API_KEY=change-me

# --- Change Risk Engine actor attribution ------------------------------------
# Who audit events / CLI submissions are attributed to. Defaults to the OS
# user if unset (same fallback dbre_platform.audit uses for DBRE_ACTOR).
# CRE_ACTOR=your-name
